# No "# syntax=" line and a digest-pinned base: either a frontend image or a
# bare tag makes BuildKit ask Docker Hub (and the host's credential helper)
# for the current digest on every build, cached or not, so every push paid a
# network lookup that could hang. The built-in Dockerfile frontend supports
# everything used here, including RUN --mount=type=cache.
#
# Pinned to go.mod's toolchain line, which GitHub CI's lint job selects via
# go-version-file. The floating 1.27 tag moved to go1.27.2, whose export data
# golangci-lint v2.13.2 cannot read. Bump this tag, the toolchain line and
# GOLANGCI_LINT_VERSION together, and replace the digest with the new tag's
# multi-platform index digest (docker buildx imagetools inspect <tag>).
FROM golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414

ARG GOLANGCI_LINT_VERSION=v2.13.2

# GOCACHE here is the build-stage cache-mount target for the tool install
# below; the runtime user gets its own caches further down.
ENV CGO_ENABLED=1 \
    GOCACHE=/root/.cache/go-build

WORKDIR /workspace

RUN apk add --no-cache \
      bash \
      build-base \
      ca-certificates \
      git \
      python3

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}

# The gate runs unprivileged so permission-denial tests execute instead of
# skipping as root. Cache directories are created and owned here so the named
# volumes that mount over them inherit that ownership on first use.
RUN adduser -D -u 1000 ci \
    && mkdir -p /go/pkg/mod /home/ci/.cache/go-build /home/ci/.cache/golangci-lint \
    && chown -R ci:ci /go /home/ci
USER ci
ENV HOME=/home/ci \
    GOCACHE=/home/ci/.cache/go-build \
    GOLANGCI_LINT_CACHE=/home/ci/.cache/golangci-lint \
    GOMODCACHE=/go/pkg/mod

CMD ["./scripts/ci-local", "--mode", "pre-push"]
