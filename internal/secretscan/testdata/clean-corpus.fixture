package main

import "fmt"

func Hello(name string) string {
	return fmt.Sprintf("Hello, %s!", name)
}

func Add(a, b int) int {
	return a + b
}

func Multiply(a, b int) int {
	return a * b
}

func main() {
	fmt.Println(Hello("World"))
	fmt.Println(Add(2, 3))
	fmt.Println(Multiply(4, 5))
}
import math


def calculate_area(radius: float) -> float:
    """Calculate the area of a circle."""
    return math.pi * radius ** 2


def calculate_circumference(radius: float) -> float:
    """Calculate the circumference of a circle."""
    return 2 * math.pi * radius


class Circle:
    def __init__(self, radius: float):
        self.radius = radius

    def area(self) -> float:
        return calculate_area(self.radius)

    def circumference(self) -> float:
        return calculate_circumference(self.radius)


def main():
    c = Circle(5.0)
    print(f"Area: {c.area()}")
    print(f"Circumference: {c.circumference()}")


if __name__ == "__main__":
    main()
export interface User {
  id: string;
  name: string;
  email: string;
}

export function createUser(name: string, email: string): User {
  return {
    id: Math.random().toString(36).substring(7),
    name,
    email,
  };
}

export function validateEmail(email: string): boolean {
  const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  return re.test(email);
}

export class UserService {
  private users: User[] = [];

  addUser(user: User): void {
    this.users.push(user);
  }

  findUser(id: string): User | undefined {
    return this.users.find((u) => u.id === id);
  }

  listUsers(): User[] {
    return [...this.users];
  }
}
This is a plain text file used for testing the sliding window chunker.
It does not contain any code, so the code-aware chunker should fall back
to the sliding window strategy.

