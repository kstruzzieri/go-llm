#!/usr/bin/env sh
set -eu

# Gate exactly what is being pushed (#630).
# Git writes one "<local ref> SP <local oid> SP <remote ref> SP <remote oid>"
# line per updated ref on stdin. The local field is the source as the user
# typed it, a revision expression that may contain spaces ('HEAD^{/fix it}'),
# so the line is split from the right. An all-zero local oid deletes a remote
# ref and pushes no code; empty stdin (nothing to update) pushes nothing.
# Refs at one tree, such as a branch and its tag, are gated once (#630).
# git push transfers the real objects, never what refs/replace maps them to,
# so peel and export with replacements off.
export GIT_NO_REPLACE_OBJECTS=1
malformed() {
  printf 'pre-push: malformed ref update from git: %s\n' "$1" >&2
  exit 1
}
is_oid() {
  case "$1" in
    '' | *[!0-9a-f]*) return 1 ;;
  esac
  [ "${#1}" -eq 40 ] || [ "${#1}" -eq 64 ]
}

trees=
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    *' '*' '*' '*) ;;
    *) malformed "$line" ;;
  esac
  remote_oid=${line##* }
  rest=${line% *}
  remote_ref=${rest##* }
  rest=${rest% *}
  local_oid=${rest##* }
  local_ref=${rest% *}
  if [ -z "$local_ref" ] || ! is_oid "$local_oid" || ! is_oid "$remote_oid"; then
    malformed "$line"
  fi
  case "$remote_ref" in
    refs/?*) ;;
    *) malformed "$line" ;;
  esac
  case "$local_oid" in
    *[!0]*) ;;
    *) continue ;;
  esac
  if ! tree="$(git rev-parse --verify --quiet "$local_oid^{tree}")"; then
    printf 'pre-push: %s (%s) names no tree to gate\n' "$local_ref" "$local_oid" >&2
    exit 1
  fi
  case " $trees " in
    *" $tree "*) ;;
    *) trees="$trees $tree" ;;
  esac
done
if [ -z "$trees" ]; then
  exit 0
fi

# Export each tree and gate that clean copy, so gitignored files, untracked
# files and uncommitted edits in this checkout cannot change the verdict and
# the container needs no .git (#306). The export lives under $TMPDIR, which the
# Docker host must be able to bind-mount (Docker Desktop shares it by
# default). The gate runs as uid 1000, which on a Linux host need not be this
# user: umask and tar.umask keep the export world-readable whatever the
# caller's umask or git config.
umask 022
work="$(mktemp -d)"
# An interrupt (Ctrl-C reaches the whole push) kills docker compose, but
# compose runs without a TTY here and leaves its container running against the
# export the EXIT trap removes. Name the container so the traps can remove it.
name="go-llm-prepush-$$"
trap 'rm -rf "$work"' EXIT
trap 'docker rm -f "$name" >/dev/null 2>&1; exit 130' INT
trap 'docker rm -f "$name" >/dev/null 2>&1; exit 143' TERM
for tree in $trees; do
  mkdir "$work/$tree"
  # Through a file, not a pipe: sh has no pipefail, and some tar
  # implementations (bsdtar, measured) accept the empty output of a failed
  # archive.
  git -c tar.umask=0022 archive --format=tar -o "$work/$tree.tar" "$tree"
  tar -xf "$work/$tree.tar" -C "$work/$tree"
  rm -f "$work/$tree.tar"
  printf 'pre-push: gating tree %s in %s\n' "$tree" "$work/$tree" >&2
  (cd "$work/$tree" && docker compose -f docker-compose.ci.yml run --build --rm --name "$name" ci ./scripts/ci-local --mode full)
done
