# Git hooks can inherit a linked worktree's metadata, index and attr source.
(
  export GIT_DIR="$(fixture_git -C "$hook_wt" rev-parse --absolute-git-dir)"
  export GIT_INDEX_FILE="$GIT_DIR/index" GIT_ATTR_SOURCE="$attributes"
  cp "$tmp/hook-committed-attributes.in" "$tmp/hook-inherited-git.in"
  run_hook hook-inherited-git "$hook_wt" 0
  assert_status hook-inherited-git 0
  assert_gated hook-inherited-git 1 "$attributes"
)

# Ctrl-C (or a closed terminal's SIGHUP) reaches the whole foreground job.
# compose dies, but its container (no TTY here) would keep running against the
# removed export, so the hook's INT/TERM/HUP traps remove the named container
# and report a removal that failed for any reason but "No such container" (an
# interrupt before compose created it). The job gets its own process group
# (set -m) and the subshell execs the hook, so the job is the hook.
printf 'refs/heads/main %s refs/heads/main %s\n' "$c1" "$zero" >"$tmp/hook-interrupt.in"
# run_interrupt NAME SIG STATUS [RM_ERROR]: signal the hook's job mid-gate; the
# stubbed `docker rm` fails with RM_ERROR when it is given.
run_interrupt() {
  : >"$tmp/$1.log"
  set -m
  (
    cd "$hook_repo"
    exec env GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 PATH="$tmp/bin:$PATH" \
      CI_LOCAL_TEST_LOG="$tmp/$1.log" CI_LOCAL_DOCKER_BLOCK="$tmp/$1.blocked" CI_LOCAL_DOCKER_RM_ERROR="${4-}" \
      "$repo_root/.githooks/pre-push" origin example.invalid <"$tmp/hook-interrupt.in" >"$tmp/$1.out" 2>&1
  ) &
  job=$!
  set +m
  waited=0
  until [ -e "$tmp/$1.blocked" ]; do
    waited=$((waited + 1))
    if [ "$waited" -gt 300 ]; then
      printf '%s: gate never started\n' "$1" >&2
      kill -s KILL -- "-$job" 2>/dev/null || true
      exit 1
    fi
    sleep 0.1
  done
  kill -s "$2" -- "-$job"
  set +e
  wait "$job"
  ci_status=$?
  set -e
  assert_status "$1" "$3"
  run_line="$(sed -n 1p "$tmp/$1.log")"
  container="$(printf '%s\n' "$run_line" | sed -n 's/.* --name \(go-llm-prepush-[0-9]*\) .*/\1/p')"
  if ! is_gate_cmd "${run_line#*|}" || [ -z "$container" ]; then
    printf '%s: gate run was %s\n' "$1" "$run_line" >&2
    exit 1
  fi
  if [ "$(sed -n 2p "$tmp/$1.log" | cut -d'|' -f2-)" != "rm -f $container" ]; then
    printf '%s: container %s was not removed; docker calls:\n' "$1" "$container" >&2
    cat "$tmp/$1.log" >&2
    exit 1
  fi
  if [ -e "${run_line%%|*}" ]; then
    printf '%s: export %s was not removed\n' "$1" "${run_line%%|*}" >&2
    exit 1
  fi
}
run_interrupt hook-interrupt-INT INT 130
run_interrupt hook-interrupt-TERM TERM 143
run_interrupt hook-interrupt-HUP HUP 129
# A container that never started is not worth a warning; a failed removal is.
run_interrupt hook-interrupt-absent INT 130 'Error response from daemon: No such container: x'
if grep -Fq 'could not remove container' "$tmp/hook-interrupt-absent.out"; then
  printf 'hook-interrupt-absent: warned about a container that never existed\n' >&2
  cat "$tmp/hook-interrupt-absent.out" >&2
  exit 1
fi
run_interrupt hook-interrupt-rm-fails INT 130 'Cannot connect to the Docker daemon at unix:///var/run/docker.sock'
if ! grep -Eq '^pre-push: could not remove container go-llm-prepush-[0-9]+: Cannot connect to the Docker daemon' "$tmp/hook-interrupt-rm-fails.out"; then
  printf 'hook-interrupt-rm-fails: the failed removal was not reported:\n' >&2
  cat "$tmp/hook-interrupt-rm-fails.out" >&2
  exit 1
fi

mkdir -p "$tmp/misplaced/scripts"
cp "$script_dir/ci-local" "$tmp/misplaced/scripts/ci-local"
if PATH="$tmp/bin:$PATH" CI_LOCAL_TEST_LOG="$tmp/misplaced-log" "$tmp/misplaced/scripts/ci-local" --mode pre-push >"$tmp/misplaced-error" 2>&1; then
  printf 'misplaced script unexpectedly succeeded\n' >&2
  exit 1
fi
grep -F "invalid local CI layout: expected go.mod and docker-compose.ci.yml in $tmp/misplaced" "$tmp/misplaced-error" >/dev/null

mkdir -p "$tmp/wrong-module/scripts"
cp "$script_dir/ci-local" "$tmp/wrong-module/scripts/ci-local"
printf 'module example.com/other\n' >"$tmp/wrong-module/go.mod"
touch "$tmp/wrong-module/docker-compose.ci.yml"
if PATH="$tmp/bin:$PATH" CI_LOCAL_TEST_LOG="$tmp/wrong-module-log" "$tmp/wrong-module/scripts/ci-local" --mode pre-push >"$tmp/wrong-module-error" 2>&1; then
  printf 'wrong-module script unexpectedly succeeded\n' >&2
  exit 1
fi
grep -F 'go.mod does not declare module github.com/kstruzzieri/go-llm' "$tmp/wrong-module-error" >/dev/null

grep -Fxq '      python3' "$repo_root/Dockerfile.ci"

grep -Fxq "        run: go test -race -run 'TestBackground(Process|Manager)|TestRunBackground|TestJobs|TestProcessExitObserver' ./agent/tools ./cmd/golem" "$repo_root/.github/workflows/darwin-smoke.yml"

awk '
  /^      - / { step = ""; env = 0 }
  $0 == "      - name: Seatbelt confinement (non-race)" { step = "non-race"; next }
  $0 == "      - name: Seatbelt confinement (race)" { step = "race"; next }
  step && $0 == "          GO_LLM_REQUIRE_SEATBELT: \"1\"" { env = 1; next }
  step == "non-race" && $0 == "        run: go test -count=1 -run '\''^(TestSeatbelt|TestSBPL|TestProbeSeatbelt|TestScratchSeatbelt|TestNewExecBackendSeatbelt)'\'' ./agent/tools" {
    nonrace = env
    step = ""
  }
  step == "race" && $0 == "        run: go test -race -count=1 -run '\''^(TestSeatbelt|TestSBPL|TestProbeSeatbelt|TestScratchSeatbelt|TestNewExecBackendSeatbelt)'\'' ./agent/tools" {
    race = env
    step = ""
  }
  END { exit !(nonrace && race) }
' "$repo_root/.github/workflows/darwin-smoke.yml"
