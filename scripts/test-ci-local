#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd "$script_dir/.." && pwd -P)"
# The go stub logs the target platform; start every run on the host's.
unset GOOS GOARCH CGO_ENABLED
if ! grep -Fq 'run: golangci-lint fmt --diff' "$repo_root/.github/workflows/ci.yml"; then
  printf 'GitHub CI is missing the all-file formatting gate\n' >&2
  exit 1
fi
if ! grep -Fxq '        run: ./scripts/ci-local --mode security' "$repo_root/.github/workflows/ci.yml"; then
  printf 'GitHub CI is missing the server-side security-contract gate\n' >&2
  exit 1
fi
# The full-mode expectations below pin ci-local's copy of these vets.
for platform in windows freebsd; do
  if ! grep -Fxq "          GOOS=$platform go vet ./..." "$repo_root/.github/workflows/ci.yml"; then
    printf 'GitHub CI is missing the %s cross-platform vet\n' "$platform" >&2
    exit 1
  fi
done
# Anchored (-x) so a commented-out line cannot satisfy the pin.
grep -Fxq 'CMD ["./scripts/ci-local", "--mode", "pre-push"]' "$repo_root/Dockerfile.ci"
grep -Fxq '    command: ["./scripts/ci-local", "--mode", "pre-push"]' "$repo_root/docker-compose.ci.yml"

# The compatibility lane must run setup-go's compiler (without GOTOOLCHAIN=local
# the toolchain directive silently swaps in the newer Go) and test the oldest Go
# the module accepts: the minor of go.mod's `go` directive.
if ! grep -Fxq '      GOTOOLCHAIN: local' "$repo_root/.github/workflows/ci.yml"; then
  printf 'GitHub CI compatibility lane is missing GOTOOLCHAIN: local\n' >&2
  exit 1
fi
floor_minor="$(sed -n 's/^go 1\.\([0-9][0-9]*\)\(\.[0-9][0-9]*\)\{0,1\}$/\1/p' "$repo_root/go.mod")"
compat_minor="$(sed -n "s/^          go-version: '1\.\([0-9][0-9]*\)\.x'\$/\1/p" "$repo_root/.github/workflows/ci.yml")"
if [ -z "$floor_minor" ] || [ "$compat_minor" != "$floor_minor" ]; then
  printf 'compatibility Go lane 1.%s.x must match the go.mod go directive 1.%s\n' \
    "$compat_minor" "$floor_minor" >&2
  exit 1
fi

tmp="$(cd "$(mktemp -d)" && pwd -P)"
trap 'rm -rf "$tmp"' EXIT

module="$tmp/module"
mkdir -p "$module/scripts" "$tmp/bin" "$tmp/outside"
cp "$script_dir/ci-local" "$module/scripts/ci-local"
printf 'module github.com/kstruzzieri/go-llm\n' >"$module/go.mod"
touch "$module/docker-compose.ci.yml"
printf 'gitdir: /unmounted/main/.git/worktrees/test\n' >"$module/.git"

cat >"$tmp/bin/golangci-lint" <<'STUB'
#!/usr/bin/env sh
if [ "${GOROOT+x}" = x ] || [ "${GOFLAGS-}" != ' ' ]; then
  printf 'lint received caller toolchain overrides\n' >&2
  exit 39
fi
printf '%s|%s\n' "$PWD" "$*" >>"$CI_LOCAL_TEST_LOG"
STUB

cat >"$tmp/bin/go" <<'STUB'
#!/usr/bin/env sh
if [ "${GOROOT+x}" = x ] || [ "${GOFLAGS-}" != ' ' ]; then
  printf 'go received caller toolchain overrides\n' >&2
  exit 39
fi
printf '%s|%s%s\n' "$PWD" "${GOOS:+GOOS=$GOOS GOARCH=${GOARCH-} CGO_ENABLED=${CGO_ENABLED-} }" "$*" >>"$CI_LOCAL_TEST_LOG"
case "$*" in
  'test -list ^TestHardeningContracts$ ./agent')
    printf 'stub: security discovery\n' >&2
    printf '%s\n' "$CI_LOCAL_DISCOVERY_OUTPUT"
    if [ "$CI_LOCAL_DISCOVERY_STATUS" -ne 0 ]; then
      printf '%s\n' "$CI_LOCAL_DISCOVERY_ERROR" >&2
      exit "$CI_LOCAL_DISCOVERY_STATUS"
    fi
    ;;
  'test -count=1 -timeout 60s -v -run ^TestHardeningContracts$ ./agent -args -hardening-budget')
    printf 'stub: security execution\n' >&2
    printf '%s\n' "$CI_LOCAL_SECURITY_OUTPUT"
    exit "$CI_LOCAL_SECURITY_STATUS"
    ;;
  'test -race ./...')
    exit "$CI_LOCAL_RACE_STATUS"
    ;;
  *TestHardeningContracts*)
    printf 'stub: unexpected security invocation: %s\n' "$*" >&2
    exit 64
    ;;
esac
STUB

cat >"$tmp/bin/python3" <<'STUB'
#!/usr/bin/env sh
exit 0
STUB

cat >"$tmp/bin/docker" <<'STUB'
#!/usr/bin/env sh
printf '%s|%s\n' "$PWD" "$*" >>"$CI_LOCAL_TEST_LOG"
# Copy the tree the gate would mount (the hook removes its export), and list
# entries the container's uid 1000 could not read on a Linux host.
if [ -n "${CI_LOCAL_DOCKER_SNAPSHOT-}" ]; then
  snap="$CI_LOCAL_DOCKER_SNAPSHOT/$(wc -l <"$CI_LOCAL_TEST_LOG" | tr -d ' ')"
  find . \( -type f ! -perm -004 \) -o \( -type d ! -perm -005 \) >"$snap.unreadable"
  mkdir "$snap"
  tar -cf - . | tar -xf - -C "$snap"
fi
exit "${CI_LOCAL_DOCKER_STATUS:-0}"
STUB
chmod +x "$tmp/bin/golangci-lint" "$tmp/bin/go" "$tmp/bin/python3" "$tmp/bin/docker"

discovery_output=TestHardeningContracts
discovery_status=0
discovery_error='discovery failed'
security_status=0
budget_line='    hardening_contract_test.go:60: hardening contracts elapsed: 29.866573ms (budget enforced: true)'
passing_output="$budget_line"'
--- PASS: TestHardeningContracts (0.01s)
    --- PASS: TestHardeningContracts/Active (0.01s)
    --- SKIP: TestHardeningContracts/ZT-602_#431_project_trust (0.00s)'
security_output="$passing_output"
race_status=0
caller_goroot=''
caller_goflags='-skip=Test'
ci_status=0

run_ci() {
  name="$1"
  shift
  : >"$tmp/$name.log"
  set +e
  (
    cd "$tmp/outside"
    if [ -n "$caller_goroot" ]; then
      export GOROOT="$caller_goroot"
    else
      unset GOROOT
    fi
    GOFLAGS="$caller_goflags" PATH="$tmp/bin:$PATH" \
      CI_LOCAL_TEST_LOG="$tmp/$name.log" \
      CI_LOCAL_DISCOVERY_OUTPUT="$discovery_output" \
      CI_LOCAL_DISCOVERY_STATUS="$discovery_status" \
      CI_LOCAL_DISCOVERY_ERROR="$discovery_error" \
      CI_LOCAL_SECURITY_STATUS="$security_status" \
      CI_LOCAL_SECURITY_OUTPUT="$security_output" \
      CI_LOCAL_RACE_STATUS="$race_status" \
      "$module/scripts/ci-local" "$@"
  ) >"$tmp/$name.out" 2>&1
  ci_status=$?
  set -e
}

assert_status() {
  if [ "$ci_status" -ne "$2" ]; then
    printf '%s: got exit %s, want %s\n' "$1" "$ci_status" "$2" >&2
    cat "$tmp/$1.out" >&2
    exit 1
  fi
}

assert_scope_notice() {
  awk '
    $0 == "note: local tests retain platform/permission skips; native bwrap/Seatbelt confinement runs in CI workflows" { count++; note = NR }
    $0 == "stub: security discovery" && !discovery { discovery = NR }
    END { exit !(count == 1 && note < discovery) }
  ' "$tmp/$1.out"
}

# -hardening-budget is the only switch for the aggregate's wall-clock budget;
# pinning it here keeps ci-local from silently dropping enforcement.
write_expected() {
  cat >"$tmp/$1" <<EOF
$module|test -list ^TestHardeningContracts$ ./agent
$module|test -count=1 -timeout 60s -v -run ^TestHardeningContracts$ ./agent -args -hardening-budget
EOF
  if [ "$2" = security ]; then
    return
  fi
  cat >>"$tmp/$1" <<EOF
$module|fmt --diff
$module|run
$module|test -race ./...
EOF
  if [ "$2" = full ]; then
    cat >>"$tmp/$1" <<EOF
$module|test -run ^$ ./...
$module|GOOS=windows GOARCH=amd64 CGO_ENABLED=0 vet ./...
$module|GOOS=freebsd GOARCH=amd64 CGO_ENABLED=0 vet ./...
EOF
  fi
}

write_expected expected-security security
write_expected expected-pre-push pre-push
write_expected expected-full full

run_ci default
assert_status default 0
diff -u "$tmp/expected-pre-push" "$tmp/default.log"
assert_scope_notice default

run_ci explicit-pre-push --mode pre-push
assert_status explicit-pre-push 0
diff -u "$tmp/expected-pre-push" "$tmp/explicit-pre-push.log"

# A hostile CDPATH must not redirect the script into a valid decoy checkout.
mkdir -p "$tmp/decoy/scripts"
printf 'module github.com/kstruzzieri/go-llm\n' >"$tmp/decoy/go.mod"
touch "$tmp/decoy/docker-compose.ci.yml"
: >"$tmp/hostile-cdpath.log"
set +e
(
  cd "$module"
  CDPATH="$tmp/decoy" PATH="$tmp/bin:$PATH" \
    CI_LOCAL_TEST_LOG="$tmp/hostile-cdpath.log" \
    CI_LOCAL_DISCOVERY_OUTPUT=TestHardeningContracts \
    CI_LOCAL_DISCOVERY_STATUS=0 \
    CI_LOCAL_DISCOVERY_ERROR='discovery failed' \
    CI_LOCAL_SECURITY_STATUS=0 \
    CI_LOCAL_SECURITY_OUTPUT="$passing_output" \
    CI_LOCAL_RACE_STATUS=0 \
    scripts/ci-local --mode pre-push
) >"$tmp/hostile-cdpath.out" 2>&1
ci_status=$?
set -e
assert_status hostile-cdpath 0
diff -u "$tmp/expected-pre-push" "$tmp/hostile-cdpath.log"

run_ci full --mode full
assert_status full 0
diff -u "$tmp/expected-full" "$tmp/full.log"

run_ci security --mode security
assert_status security 0
diff -u "$tmp/expected-security" "$tmp/security.log"
assert_scope_notice security

caller_goroot=/poisoned
run_ci poisoned-goroot --mode full
assert_status poisoned-goroot 0
diff -u "$tmp/expected-full" "$tmp/poisoned-goroot.log"
caller_goroot=''

# A successful process must also report the exact top-level test and its
# Active group passing; only the declared boundary names may skip.
pass_message='required security test did not pass: TestHardeningContracts (top-level and Active group must PASS)'
skip_message='unexpected skip inside TestHardeningContracts:'
budget_message='required security test did not enforce its budget: TestHardeningContracts (must log budget enforced: true)'
for mode in security pre-push full; do
  for outcome in empty skipped fail renamed child active-missing active-skipped; do
    case "$outcome" in
      empty) security_output='PASS' ;;
      skipped) security_output='--- SKIP: TestHardeningContracts (0.00s)' ;;
      fail) security_output='--- FAIL: TestHardeningContracts (0.00s)' ;;
      renamed) security_output='--- PASS: TestHardeningContractsRenamed (0.00s)' ;;
      child) security_output='    --- PASS: TestHardeningContracts/Active (0.00s)' ;;
      active-missing) security_output='--- PASS: TestHardeningContracts (0.00s)' ;;
      active-skipped) security_output='--- PASS: TestHardeningContracts (0.00s)
    --- SKIP: TestHardeningContracts/Active (0.00s)' ;;
    esac
    run_ci "aggregate-$outcome-$mode" --mode "$mode"
    assert_status "aggregate-$outcome-$mode" 1
    grep -Fxq "$pass_message" "$tmp/aggregate-$outcome-$mode.out"
    grep -Fxq -- "$(printf '%s\n' "$security_output" | tail -n 1)" "$tmp/aggregate-$outcome-$mode.out"
    diff -u "$tmp/expected-security" "$tmp/aggregate-$outcome-$mode.log"
  done
  # A skip anywhere under Active, or an undeclared boundary skip, fails even
  # though both required PASS lines are present.
  for outcome in inner-skip completed-432 completed-433 undeclared-boundary; do
    case "$outcome" in
      inner-skip) skip_line='        --- SKIP: TestHardeningContracts/Active/Secrets (0.00s)' ;;
      completed-432) skip_line='    --- SKIP: TestHardeningContracts/ZT-603_#432_MCP_description_catalog_trust (0.00s)' ;;
      completed-433) skip_line='    --- SKIP: TestHardeningContracts/ZT-604_#433_terminal_output (0.00s)' ;;
      undeclared-boundary) skip_line='    --- SKIP: TestHardeningContracts/ZT-999_#999_new (0.00s)' ;;
    esac
    security_output="$passing_output
$skip_line"
    run_ci "aggregate-$outcome-$mode" --mode "$mode"
    assert_status "aggregate-$outcome-$mode" 1
    grep -Fxq "$skip_message" "$tmp/aggregate-$outcome-$mode.out"
    grep -Fxq -- "$skip_line" "$tmp/aggregate-$outcome-$mode.out"
    diff -u "$tmp/expected-security" "$tmp/aggregate-$outcome-$mode.log"
  done
  # The run must also report that it enforced its wall-clock budget; a missing
  # or false report means the budget block or the flag did not reach it.
  for outcome in budget-missing budget-off; do
    case "$outcome" in
      budget-missing) security_output="$(printf '%s\n' "$passing_output" | tail -n +2)" ;;
      budget-off) security_output="$(printf '%s\n' "$passing_output" | sed 's/(budget enforced: true)$/(budget enforced: false)/')" ;;
    esac
    run_ci "aggregate-$outcome-$mode" --mode "$mode"
    assert_status "aggregate-$outcome-$mode" 1
    grep -Fxq "$budget_message" "$tmp/aggregate-$outcome-$mode.out"
    diff -u "$tmp/expected-security" "$tmp/aggregate-$outcome-$mode.log"
  done
  security_output="$budget_line"'
--- PASS: TestHardeningContracts (0.01s)
    --- PASS: TestHardeningContracts/Active (0.01s)
    --- SKIP: TestHardeningContracts/ZT-602_#431_project_trust (0.00s)
    --- SKIP: TestHardeningContracts/ZT-605_#434_quarantine (0.00s)
    --- SKIP: TestHardeningContracts/ZT-606_#435_retrieval_screening (0.00s)'
  run_ci "deferred-$mode" --mode "$mode"
  assert_status "deferred-$mode" 0
  diff -u "$tmp/expected-$mode" "$tmp/deferred-$mode.log"
done
security_output="$passing_output"

discovery_output='? github.com/kstruzzieri/go-llm/other [no test files]
TestHardeningContracts
ok github.com/kstruzzieri/go-llm/agent 0.001s'
run_ci package-summary --mode pre-push
assert_status package-summary 0
diff -u "$tmp/expected-pre-push" "$tmp/package-summary.log"

discovery_output=''
head -n 1 "$tmp/expected-security" >"$tmp/expected-discovery-only"
for mode in security pre-push full; do
  run_ci "missing-empty-$mode" --mode "$mode"
  assert_status "missing-empty-$mode" 1
  grep -Fxq 'missing required security test: TestHardeningContracts' "$tmp/missing-empty-$mode.out"
  diff -u "$tmp/expected-discovery-only" "$tmp/missing-empty-$mode.log"
done

discovery_output=TestHardeningContractsRenamed
for mode in security pre-push full; do
  run_ci "missing-renamed-$mode" --mode "$mode"
  assert_status "missing-renamed-$mode" 1
  grep -Fxq 'missing required security test: TestHardeningContracts' "$tmp/missing-renamed-$mode.out"
  diff -u "$tmp/expected-discovery-only" "$tmp/missing-renamed-$mode.log"
done

discovery_output=TestHardeningContracts
discovery_status=38
discovery_error='discovery status 38 preserved'
run_ci discovery-failure --mode pre-push
assert_status discovery-failure 38
grep -Fxq 'discovery status 38 preserved' "$tmp/discovery-failure.out"
diff -u "$tmp/expected-discovery-only" "$tmp/discovery-failure.log"

discovery_status=0
for mode in security pre-push full; do
  security_status=37
  run_ci "security-failure-$mode" --mode "$mode"
  assert_status "security-failure-$mode" 37
  grep -Fxq -- "$(printf '%s\n' "$security_output" | head -n 1)" "$tmp/security-failure-$mode.out"
  diff -u "$tmp/expected-security" "$tmp/security-failure-$mode.log"
done

security_status=0
for mode in pre-push full; do
  race_status=36
  run_ci "race-failure-$mode" --mode "$mode"
  assert_status "race-failure-$mode" 36
  diff -u "$tmp/expected-pre-push" "$tmp/race-failure-$mode.log"
done
race_status=0

mkdir -p "$tmp/no-python"
ln -s "$tmp/bin/go" "$tmp/no-python/go"
ln -s "$tmp/bin/golangci-lint" "$tmp/no-python/golangci-lint"
ln -s "$(command -v dirname)" "$tmp/no-python/dirname"
ln -s "$(command -v grep)" "$tmp/no-python/grep"
: >"$tmp/missing-python.log"
set +e
(
  cd "$tmp/outside"
  PATH="$tmp/no-python" CI_LOCAL_TEST_LOG="$tmp/missing-python.log" \
    /bin/bash "$module/scripts/ci-local" --mode pre-push
) >"$tmp/missing-python.out" 2>&1
ci_status=$?
set -e
assert_status missing-python 127
cat >"$tmp/expected-missing-python" <<'EOF'
missing required command: python3
hint: install the missing command for host runs; for Docker CI, rebuild with: docker compose -f docker-compose.ci.yml build ci
EOF
diff -u "$tmp/expected-missing-python" "$tmp/missing-python.out"
test ! -s "$tmp/missing-python.log"

# The test suite refuses to run as root before any phase: root skips every
# permission-denial path, so a green would be hollow. Security mode runs
# nothing permission-sensitive and still passes.
mkdir -p "$tmp/root-bin"
cat >"$tmp/root-bin/id" <<'STUB'
#!/usr/bin/env sh
printf '0\n'
STUB
chmod +x "$tmp/root-bin/id"
run_ci_as_root() {
  name="$1"
  shift
  : >"$tmp/$name.log"
  set +e
  (
    cd "$tmp/outside"
    unset GOROOT
    GOFLAGS="$caller_goflags" PATH="$tmp/root-bin:$tmp/bin:$PATH" \
      CI_LOCAL_TEST_LOG="$tmp/$name.log" \
      CI_LOCAL_DISCOVERY_OUTPUT="$discovery_output" \
      CI_LOCAL_DISCOVERY_STATUS="$discovery_status" \
      CI_LOCAL_DISCOVERY_ERROR="$discovery_error" \
      CI_LOCAL_SECURITY_STATUS="$security_status" \
      CI_LOCAL_SECURITY_OUTPUT="$security_output" \
      CI_LOCAL_RACE_STATUS="$race_status" \
      "$module/scripts/ci-local" "$@"
  ) >"$tmp/$name.out" 2>&1
  ci_status=$?
  set -e
}
for mode in pre-push full; do
  run_ci_as_root "root-$mode" --mode "$mode"
  assert_status "root-$mode" 2
  grep -Fxq 'ci-local: refusing to run the test suite as root; permission-denial tests would skip' "$tmp/root-$mode.out"
  grep -Fxq 'hint: rebuild the CI image: docker compose -f docker-compose.ci.yml build ci' "$tmp/root-$mode.out"
  test ! -s "$tmp/root-$mode.log"
done
run_ci_as_root root-security --mode security
assert_status root-security 0
write_expected expected-root-security security
diff -u "$tmp/expected-root-security" "$tmp/root-security.log"

# The pre-push hook gates the trees being pushed, never this checkout's files
# (#630). The fixture repository commits a tree, then adds a gitignored
# package, an untracked file and an uncommitted edit, none of which may reach
# the gate; a linked worktree of it holds a second commit. Needs git >= 2.32
# (GIT_CONFIG_GLOBAL).
# Repository-local variables (GIT_DIR, GIT_INDEX_FILE, ...) inherited from a
# caller would redirect the fixture's git commands; clear them.
unset $(git rev-parse --local-env-vars)
# The oracle (expected manifests and contents) disables replacements, so it
# cannot share a replacement defect with the hook.
fixture_git() {
  GIT_NO_REPLACE_OBJECTS=1 GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git \
    -c user.name=test-ci-local -c user.email=test-ci-local@localhost \
    -c commit.gpgsign=false -c tag.gpgsign=false "$@"
}
hook_repo="$tmp/hook-repo"
mkdir -p "$hook_repo"
fixture_git -C "$hook_repo" init -q --template=
printf 'ignored/\n' >"$hook_repo/.gitignore"
printf 'module example.com/fixture\n' >"$hook_repo/go.mod"
printf 'package fixture\n' >"$hook_repo/tracked.go"
fixture_git -C "$hook_repo" add -A
fixture_git -C "$hook_repo" commit -qm one
c1="$(fixture_git -C "$hook_repo" rev-parse HEAD)"
fixture_git -C "$hook_repo" tag -a v1 -m v1
tag1="$(fixture_git -C "$hook_repo" rev-parse v1)"
hook_wt="$tmp/hook-wt"
fixture_git -C "$hook_repo" worktree add -q -b wt "$hook_wt"
printf 'package fixture\n\nfunc Second() {}\n' >"$hook_wt/second.go"
fixture_git -C "$hook_wt" add second.go
fixture_git -C "$hook_wt" commit -qm two
c2="$(fixture_git -C "$hook_wt" rev-parse HEAD)"
for checkout in "$hook_repo" "$hook_wt"; do
  mkdir -p "$checkout/ignored"
  printf 'package ignored\nfunc  Bad(){}\n' >"$checkout/ignored/bad.go"
  printf 'package fixture\n' >"$checkout/untracked.go"
  printf 'func  Dirty(){}\n' >>"$checkout/tracked.go"
done
zero=0000000000000000000000000000000000000000
gate_cmd='compose -f docker-compose.ci.yml run --build --rm ci ./scripts/ci-local --mode full'

# run_hook NAME CHECKOUT DOCKER_STATUS runs the hook from CHECKOUT with
# $tmp/NAME.in as git's stdin, under a hostile umask and a hostile tar.umask
# (command-scope config, which an explicit `git -c` overrides).
run_hook() {
  : >"$tmp/$1.log"
  rm -rf "$tmp/$1.snap"
  mkdir "$tmp/$1.snap"
  set +e
  (
    cd "$2"
    umask 077
    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
      GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=tar.umask GIT_CONFIG_VALUE_0=0077 \
      PATH="$tmp/bin:$PATH" CI_LOCAL_TEST_LOG="$tmp/$1.log" CI_LOCAL_DOCKER_SNAPSHOT="$tmp/$1.snap" \
      CI_LOCAL_DOCKER_STATUS="$3" "$repo_root/.githooks/pre-push" origin example.invalid <"$tmp/$1.in"
  ) >"$tmp/$1.out" 2>&1
  ci_status=$?
  set -e
}

assert_gate_runs() {
  got="$(wc -l <"$tmp/$1.log" | tr -d ' ')"
  if [ "$got" != "$2" ]; then
    printf '%s: %s gate runs, want %s\n' "$1" "$got" "$2" >&2
    cat "$tmp/$1.log" "$tmp/$1.out" >&2
    exit 1
  fi
}

# Up to date: git runs the hook with empty stdin.
: >"$tmp/hook-empty.in"
run_hook hook-empty "$hook_repo" 0
assert_status hook-empty 0
assert_gate_runs hook-empty 0

# Deletion only, SHA-1 and SHA-256 zero ids.
printf '(delete) %s refs/heads/gone %s\n(delete) %s%s refs/heads/gone256 %s\n' \
  "$zero" "$c1" "$zero" 000000000000000000000000 "$c1" >"$tmp/hook-delete.in"
run_hook hook-delete "$hook_repo" 0
assert_status hook-delete 0
assert_gate_runs hook-delete 0

# Malformed input fails closed before Docker.
n=0
# 7: an abbreviated id git would resolve; 8: a short remote id; 9: 40
# characters that are not hex.
for bad in 'garbage' 'x 0' 'a b c' "r 85e3 refs/heads/x $zero" "r $c1 notref $zero" " $c1 refs/heads/x $zero" \
  "r ${c1%?} refs/heads/x $zero" "r $c1 refs/heads/x 00" "r ${c1%?}g refs/heads/x $zero"; do
  n=$((n + 1))
  printf '%s\n' "$bad" >"$tmp/hook-malformed-$n.in"
  run_hook "hook-malformed-$n" "$hook_repo" 0
  assert_status "hook-malformed-$n" 1
  assert_gate_runs "hook-malformed-$n" 0
  if ! grep -Fq 'pre-push: malformed ref update from git:' "$tmp/hook-malformed-$n.out"; then
    printf 'hook-malformed-%s: rejected without the malformed diagnostic:\n' "$n" >&2
    cat "$tmp/hook-malformed-$n.out" >&2
    exit 1
  fi
done

# An id git cannot peel to a tree fails the push before Docker.
printf 'refs/heads/main %s refs/heads/main %s\n' ffffffffffffffffffffffffffffffffffffffff "$zero" >"$tmp/hook-missing.in"
run_hook hook-missing "$hook_repo" 0
assert_status hook-missing 1
assert_gate_runs hook-missing 0

# The source field is the user's expression and may contain spaces and a
# lone 0 (`git push origin 'HEAD^{/one| 0 }:refs/heads/expr'`); the line is
# split from the right, so it is still an update. The last line has no newline.
printf 'HEAD^{/one| 0 } %s refs/heads/expr %s\nHEAD^{/fix it} %s refs/heads/expr2 %s' \
  "$c1" "$zero" "$c1" "$zero" >"$tmp/hook-expr.in"
run_hook hook-expr "$hook_repo" 0
assert_status hook-expr 0
assert_gate_runs hook-expr 1

# A lone update without its terminating newline is still gated.
printf 'refs/heads/main %s refs/heads/main %s' "$c1" "$zero" >"$tmp/hook-nonl.in"
run_hook hook-nonl "$hook_repo" 0
assert_status hook-nonl 0
assert_gate_runs hook-nonl 1

# An update runs the gate once, and its status is the hook's.
printf 'refs/heads/main %s refs/heads/main %s\n' "$c1" "$zero" >"$tmp/hook-update.in"
for docker_status in 0 35; do
  cp "$tmp/hook-update.in" "$tmp/hook-update-$docker_status.in"
  run_hook "hook-update-$docker_status" "$hook_repo" "$docker_status"
  assert_status "hook-update-$docker_status" "$docker_status"
  assert_gate_runs "hook-update-$docker_status" 1
  test "$(cut -d'|' -f2- "$tmp/hook-update-$docker_status.log")" = "$gate_cmd"
done

# A branch and its annotated tag name one tree: one gate run. Two refs at one
# commit, mixed with a deletion: one gate run.
printf 'refs/heads/main %s refs/heads/main %s\nrefs/tags/v1 %s refs/tags/v1 %s\n(delete) %s refs/heads/gone %s\nrefs/heads/copy %s refs/heads/copy %s\n' \
  "$c1" "$zero" "$tag1" "$zero" "$zero" "$c1" "$c1" "$zero" >"$tmp/hook-dedupe.in"
run_hook hook-dedupe "$hook_repo" 0
assert_status hook-dedupe 0
assert_gate_runs hook-dedupe 1

mkdir -p "$tmp/misplaced/scripts"
cp "$script_dir/ci-local" "$tmp/misplaced/scripts/ci-local"
if PATH="$tmp/bin:$PATH" CI_LOCAL_TEST_LOG="$tmp/misplaced-log" "$tmp/misplaced/scripts/ci-local" --mode pre-push >"$tmp/misplaced-error" 2>&1; then
  printf 'misplaced script unexpectedly succeeded\n' >&2
  exit 1
fi
grep -F "invalid local CI layout: expected go.mod and docker-compose.ci.yml in $tmp/misplaced" "$tmp/misplaced-error" >/dev/null

mkdir -p "$tmp/wrong-module/scripts"
cp "$script_dir/ci-local" "$tmp/wrong-module/scripts/ci-local"
printf 'module example.com/other\n' >"$tmp/wrong-module/go.mod"
touch "$tmp/wrong-module/docker-compose.ci.yml"
if PATH="$tmp/bin:$PATH" CI_LOCAL_TEST_LOG="$tmp/wrong-module-log" "$tmp/wrong-module/scripts/ci-local" --mode pre-push >"$tmp/wrong-module-error" 2>&1; then
  printf 'wrong-module script unexpectedly succeeded\n' >&2
  exit 1
fi
grep -F 'go.mod does not declare module github.com/kstruzzieri/go-llm' "$tmp/wrong-module-error" >/dev/null

grep -Fxq '      python3' "$repo_root/Dockerfile.ci"

grep -Fxq "        run: go test -race -run 'TestBackground(Process|Manager)|TestRunBackground|TestJobs|TestProcessExitObserver' ./agent/tools ./cmd/golem" "$repo_root/.github/workflows/darwin-smoke.yml"

awk '
  /^      - / { step = ""; env = 0 }
  $0 == "      - name: Seatbelt confinement (non-race)" { step = "non-race"; next }
  $0 == "      - name: Seatbelt confinement (race)" { step = "race"; next }
  step && $0 == "          GO_LLM_REQUIRE_SEATBELT: \"1\"" { env = 1; next }
  step == "non-race" && $0 == "        run: go test -count=1 -run '\''^(TestSeatbelt|TestSBPL|TestProbeSeatbelt|TestScratchSeatbelt|TestNewExecBackendSeatbelt)'\'' ./agent/tools" {
    nonrace = env
    step = ""
  }
  step == "race" && $0 == "        run: go test -race -count=1 -run '\''^(TestSeatbelt|TestSBPL|TestProbeSeatbelt|TestScratchSeatbelt|TestNewExecBackendSeatbelt)'\'' ./agent/tools" {
    race = env
    step = ""
  }
  END { exit !(nonrace && race) }
' "$repo_root/.github/workflows/darwin-smoke.yml"
