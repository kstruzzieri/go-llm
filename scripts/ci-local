#!/usr/bin/env bash
set -euo pipefail

# Local tests retain platform and permission skips; native CI workflows enforce
# bwrap and Seatbelt confinement.

mode="pre-push"

usage() {
  cat <<'USAGE'
Usage: scripts/ci-local [--mode security|pre-push|full]

Modes:
  security  Run only the hardening-contract phase (used by the GitHub CI job).
  pre-push  Run fast deterministic checks intended for every push.
  full      Run pre-push checks plus slower compile smoke checks.
USAGE
}

section() {
  printf '\n==> %s\n' "$1"
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'missing required command: %s\n' "$1" >&2
    printf 'hint: install the missing command for host runs; for Docker CI, rebuild with: docker compose -f docker-compose.ci.yml build ci\n' >&2
    exit 127
  fi
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --mode)
      if [ "$#" -lt 2 ]; then
        printf '--mode requires a value\n' >&2
        usage >&2
        exit 2
      fi
      mode="$2"
      shift 2
      ;;
    --mode=*)
      mode="${1#*=}"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "$mode" in
  security|pre-push|full)
    ;;
  *)
    printf 'unknown mode: %s\n' "$mode" >&2
    usage >&2
    exit 2
    ;;
esac

# Run from the module root so `golangci-lint` and `go test ./...` resolve
# packages regardless of the caller's working directory. Resolve the root from
# this script's location, not the caller's CWD, so absolute-path invocations
# from outside the repo cannot select the wrong enclosing git checkout.
# CDPATH= keeps an exported CDPATH from redirecting the relative `cd` into a
# different checkout when the script is invoked by a relative path.
script_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd "$script_dir/.." && pwd -P)"
if [ ! -f "$repo_root/go.mod" ] || [ ! -f "$repo_root/docker-compose.ci.yml" ]; then
  printf 'invalid local CI layout: expected go.mod and docker-compose.ci.yml in %s\n' "$repo_root" >&2
  exit 1
fi
if ! grep -q '^module github.com/kstruzzieri/go-llm$' "$repo_root/go.mod"; then
  printf 'invalid local CI layout: %s/go.mod does not declare module github.com/kstruzzieri/go-llm\n' "$repo_root" >&2
  exit 1
fi
cd "$repo_root"

require_cmd go
require_cmd golangci-lint
require_cmd python3

# Apply the same toolchain environment to Go and lint. `unset` covers every
# later command in this script. Nonempty whitespace overrides even GOFLAGS
# saved by `go env -w`, while supplying no flags.
unset GOROOT
export GOFLAGS=' '

section "security contracts"
printf 'note: local tests retain platform/permission skips; native bwrap/Seatbelt confinement runs in CI workflows\n'
security_tests="$(go test -list '^TestHardeningContracts$' ./agent)"
if ! grep -Fxq 'TestHardeningContracts' <<<"$security_tests"; then
  printf 'missing required security test: TestHardeningContracts\n' >&2
  exit 1
fi
security_status=0
# The aggregate asserts its own <500ms budget; the timeout bounds a hang at
# well under Go's 10-minute default so a stuck pre-push fails quickly.
security_output="$(go test -count=1 -timeout 60s -v -run '^TestHardeningContracts$' ./agent)" || security_status=$?
printf '%s\n' "$security_output"
if [ "$security_status" -ne 0 ]; then
  exit "$security_status"
fi
# Require the exact top-level PASS and the Active group PASS: every real
# contract lives under Active, so a skipped Active is a zero-contract success.
if ! grep -Eq '^--- PASS: TestHardeningContracts \([0-9.]+s\)$' <<<"$security_output" \
  || ! grep -Eq '^    --- PASS: TestHardeningContracts/Active \([0-9.]+s\)$' <<<"$security_output"; then
  printf 'required security test did not pass: TestHardeningContracts (top-level and Active group must PASS)\n' >&2
  exit 1
fi
# Only the declared deferred boundary groups may skip. Captured into a
# variable rather than piped into `grep -q`: an early-exiting downstream grep
# would SIGPIPE the upstream one and invert the condition under pipefail.
unexpected_skips="$(grep -E '^ +--- SKIP: ' <<<"$security_output" \
  | grep -Ev '^    --- SKIP: TestHardeningContracts/ZT-60[2-6]_#43[1-5]_' || true)"
if [ -n "$unexpected_skips" ]; then
  printf 'unexpected skip inside TestHardeningContracts:\n%s\n' "$unexpected_skips" >&2
  exit 1
fi
if [ "$mode" = security ]; then
  exit 0
fi

section "format"
golangci-lint fmt --diff

section "lint"
golangci-lint run

section "race tests"
go test -race ./...

if [ "$mode" = "full" ]; then
  section "compile smoke"
  go test -run '^$' ./...
fi
